---
import Layout from '../../layouts/Layout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAllProducts, getAllBrands, getAllCategories } from '../../utils/catalog-client';
import { mapProductToCard } from '../../utils/product-card';
import { slugFor } from '../../utils/slugs';
import { resolveCategoryImage } from '../../utils/category-image';

const [categories, allProductsData, brandsData] = await Promise.all([
  getAllCategories(),
  getAllProducts(),
  getAllBrands(),
]);

const allProducts = allProductsData.map(mapProductToCard);

const brands = (brandsData ?? [])
  .filter((brand) => brand.name)
  .map((brand) => ({ name: brand.name, logo: brand.logo || null }));

const categoriesToShow = categories.map((category) => ({
  ...category,
  href: `/produits/${slugFor(category)}`,
}));

// Photo-first tiles, same language as the homepage category cards; anything
// without a photo falls back to a branded gradient.
const categoryTints = [
  'from-marine to-royal',
  'from-royal to-blue-500',
  'from-blue-800 to-blue-600',
  'from-blue-900 to-blue-700',
];
---

<Layout title="Nos Produits" description="Découvrez notre large gamme de matelas, sommiers, têtes de lit et accessoires de literie">
  <div class="home-sans">
    <!-- Header -->
    <PageHero image="/images/design/hero-bedroom.jpg" imageAlt="Showroom literie Bleunuit">
      <Breadcrumb
        variant="dark"
        class="mb-6"
        items={[{ name: 'Accueil', href: '/' }, { name: 'Produits' }]}
      />
      <p
        class="flex items-center gap-2.5 text-[11px] font-semibold uppercase tracking-[0.28em] text-white/80"
      >
        <svg
          class="h-3.5 w-3.5 text-gold"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        Univers literie
      </p>
      <h1
        class="home-display mt-5 text-balance text-display drop-shadow-[0_2px_18px_rgba(4,10,25,0.45)]"
      >
        Nos produits.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/85 drop-shadow-[0_1px_10px_rgba(4,10,25,0.4)]">
        Matelas, sommiers, têtes de lit et accessoires sélectionnés pour leur
        confort et leur durabilité — à essayer en conditions réelles dans nos
        magasins.
      </p>
    </PageHero>

    <!-- Categories -->
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-gray-400">
              Univers literie
            </p>
            <h2 class="text-h1 text-marine mt-4">
              Explorez nos catégories.
            </h2>
          </div>
          <a href="/contact" class="text-sm font-semibold text-marine">
            Nous contacter
          </a>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {categoriesToShow.map((category, index) => {
            const img = resolveCategoryImage(category);
            return (
              <a
                href={category.href}
                class="group relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-3xl shadow-lg"
              >
                {img ? (
                  <>
                    <img
                      src={img}
                      alt={`Catégorie ${category.name}`}
                      class="absolute inset-0 -z-10 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                      width="640"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                    <div
                      class="absolute inset-0 -z-10 bg-gradient-to-t from-blue-900/85 via-blue-900/25 to-blue-900/0"
                      aria-hidden="true"
                    />
                  </>
                ) : (
                  <div
                    class={`absolute inset-0 -z-10 bg-gradient-to-br ${categoryTints[index % categoryTints.length]} transition duration-700 group-hover:scale-105`}
                    aria-hidden="true"
                  />
                )}
                <div class="p-6">
                  <h3 class="home-display text-h3 text-white">{category.name}</h3>
                  {category.description && (
                    <p class="mt-2 line-clamp-2 text-sm text-white/75">
                      {category.description}
                    </p>
                  )}
                  <span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-white/85">
                    Explorer
                    <svg
                      class="h-4 w-4 transition group-hover:translate-x-0.5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h10v10" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- All Products -->
    <section class="bg-page py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-gray-400">
            Notre sélection
          </p>
          <h2 class="text-h1 text-marine mt-4">
            Tous nos produits.
          </h2>
        </div>

        <div class="mt-12">
          <ProductGrid products={allProducts} />
        </div>
      </div>
    </section>

    <!-- Brands -->
    <section class="py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-gray-400">
          Marques partenaires
        </p>
        <h2 class="text-h1 text-marine mt-4">
          Les signatures que nous aimons.
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-sm text-gray-700">
          Des marques sélectionnées pour leur fiabilité, leur confort et leur
          qualité de fabrication.
        </p>

        <div class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-4 sm:grid-cols-3">
          {brands.length > 0 ? (
            brands.map((brand) => (
              <div class="flex items-center justify-center rounded-2xl border border-gray-200 bg-white px-4 py-5 text-sm font-semibold text-gray-700">
                {brand.logo ? (
                  <img
                    src={brand.logo}
                    alt={brand.name}
                    class="h-10 w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  brand.name
                )}
              </div>
            ))
          ) : (
            <p class="col-span-full text-sm text-gray-500">
              Aucune marque disponible pour le moment.
            </p>
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>
